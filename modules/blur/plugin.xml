<?xml version="1.0" ?>
<!DOCTYPE plugin PUBLIC "-//JPF//Java Plug-in Manifest 1.0" "http://jpf.sourceforge.net/plugin_1_0.dtd">

<plugin id="org.alchemy.affect.blur" version="1.0.0">
    
    <requires> 
        <import plugin-id="org.alchemy.core"/> 
    </requires> 
    
    <runtime>
        <library id="blur" path="/" type="code">
            <export prefix="*" /> 
        </library>
        <library type="resources" path="data/" id="data" />
    </runtime>
    
    <extension plugin-id="org.alchemy.core" point-id="Affect" id="blurAffect"> 
        <parameter id="class" value="org.alchemy.affect.Blur"/> 
        <parameter id="name" value="Blur"/> 
        <parameter id="description" value="Blur the shapes under the pen while Q is held" />
        <parameter id="icon" value="icon.png" />
    </extension>
    
</plugin>
