<?xml version="1.0" ?>
<!DOCTYPE plugin PUBLIC "-//JPF//Java Plug-in Manifest 1.0" "http://jpf.sourceforge.net/plugin_1_0.dtd">

<plugin id="org.alchemy.create.brushShapes" version="1.0.0">
    
    <requires> 
        <import plugin-id="org.alchemy.core"/> 
    </requires> 
    
    <runtime>
        <library id="brushShapes" path="/" type="code">
            <export prefix="*" /> 
        </library>
        <library type="resources" path="data/" id="data" />
    </runtime>
    
    <extension plugin-id="org.alchemy.core" point-id="Create" id="brushShapesCreate"> 
        <parameter id="class" value="org.alchemy.create.BrushShapes"/> 
        <parameter id="name" value="Brushes"/> 
        <parameter id="description" value="Sketching brushes - pencil, ink pen, marker and charcoal" />
        <parameter id="icon" value="icon.png" />
    </extension>
    
</plugin>
